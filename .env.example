# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# LangSmith (used by both the native-SDK agent and the OpenLLMetry OTLP export)
LANGSMITH_API_KEY=lsv2_xxxxxxxx
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_OTEL_ENDPOINT=https://api.smith.langchain.com/otel

# Four LangSmith projects this repo fans traces out to. LANGSMITH_PROJECT
# holds the single connected trace spanning frontend -> agent -> retriever;
# the other three each get a per-service duplicate (see README's
# "Multi-project fan-out" section). Names must match projects you've already
# created in LangSmith -- change these if yours are named differently.
LANGSMITH_PROJECT=distributed
LANGSMITH_PROJECT_FRONTEND=frontend
LANGSMITH_PROJECT_AGENT=agent
LANGSMITH_PROJECT_VECTORDB=vector_database
